+def secure_getpass(prompt="Password to check (or type 'exit'): "):
+    sys.stderr.write(prompt)
+    sys.stderr.flush()
 
+    password_bytes = bytearray()
+    try:
+        while True:
+            ch = msvcrt.getch()
+
+            if ch in (b'\r', b'\n'):
+                sys.stderr.write('\n')
+                sys.stderr.flush()
+                break
+
+            elif ch in (b'\x08', b'\x7f'):
+                if len(password_bytes) > 0:
+                    password_bytes.pop()
+
+            elif ch == b'\x03':
+                raise KeyboardInterrupt()
+
+            elif ch in (b'\x00', b'\xe0'):
+                msvcrt.getch()
+                continue
+
+            else:
+                password_bytes.extend(ch)
+
+    except (KeyboardInterrupt, Exception) as e:
+        zero_buffer(password_bytes)
+        raise e
+
+    return password_bytes
+
+def get_hash(password_bytes: bytearray):
+    hash_objekt = hashlib.sha1(password_bytes)
+    return hash_objekt.hexdigest().upper()
 
 def slicer(hash_wert):
