+def check_file(file_path):
+    password_bytes = bytearray()
+    try:
+        with open(file_path, 'rb') as f:
+            while True:
+                chunk = f.read(4096)
+                if not chunk:
+                    if password_bytes:
+                        check_password(password_bytes)
+                        zero_buffer(password_bytes)
+                    break
+                
+                for byte in chunk:
+                    if byte == 10: # \n
+                        if password_bytes:
+                            check_password(password_bytes)
+                            zero_buffer(password_bytes)
+                            password_bytes = bytearray()
+                    elif byte != 13: # \r
+                        password_bytes.append(byte)
+    except FileNotFoundError:
+        print(f"File not found: {file_path}")
 
